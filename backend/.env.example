# Application Configuration
PROJECT_NAME="AgriTech Backend API"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api"

# CORS Configuration (comma-separated list for origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MongoDB Atlas Configuration
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="agritech_db"

# JWT Authentication
JWT_SECRET_KEY=1dd96dee8f032be2ce61d87f3a5b70efbc4d8344fffc3d2ba20fba30e198715e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Gemini API (required for the AI Agri Assistant; obtain a key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-3-flash-preview"

# External SLUSI soil GeoJSONL dataset (do not copy this file into the repository)
SLUSI_SOIL_DATASET_PATH="D:\\path\\to\\_SHC.geojsonl"
