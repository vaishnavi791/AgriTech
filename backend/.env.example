# Application Configuration
PROJECT_NAME="AgriTech Backend API"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api"

# CORS Configuration (comma-separated list for origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MongoDB Atlas Configuration
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="agritech_db"

# JWT Authentication
JWT_SECRET_KEY=<your-secret-key>
JWT_ALGORITHM=<configured-algorithm>
ACCESS_TOKEN_EXPIRE_MINUTES=<expiration-in-minutes>

# Gemini API (Reserved for Chatbot Prompt)
GEMINI_API_KEY="your-gemini-api-key-here"

